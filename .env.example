# GEMINI_API_KEY: Required for Gemini AI API calls (if applicable)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"

# ----------------------------------------------------
# تنظیمات احراز هویت پنل ادمین پارک‌وی کالا (Parkway Kala)
# این اطلاعات هرگز در Frontend، Git یا کلاینت نمایش داده نمی‌شود.
# ----------------------------------------------------
ADMIN_USERNAME="your_admin_username"
ADMIN_PASSWORD="your_secure_password"

# آدرس پنل ادمین پارک‌وی کالا
PARKWAY_ADMIN_URL="https://admin.parkwaykala.ir"

# زمان‌بندی اجرای خودکار روزانه (فرمت HH:mm به وقت ایران)
SCHEDULE_TIME="23:00"
TIMEZONE="Asia/Tehran"

# محل ذخیره گزارش‌ها، تصاویر و فایل‌های زیپ
STORAGE_PATH="./storage"
PORT=3000

